# Password gate for /crafts/* craft routes (src/components/playground/password-gate.tsx).
# Copy this file to .env.local (already gitignored - never commit real values here).
#
# Only SHA-256 hashes go in these variables, never the plaintext password -
# generate one for whatever password you choose:
#
#   node -e "console.log(require('crypto').createHash('sha256').update('your-password-here').digest('hex'))"
#
# This is a casual client-side gate (keeps a shared link from being stumbled
# on), not real security - there's no backend, so the hash still ships in the
# built JS bundle. Good enough for sharing work-in-progress links.

# Unlocks every craft. Set this to your own password's hash.
VITE_ADMIN_PASSWORD_HASH=

# One hash per craft slug (src/crafts/registry.ts) - unlocks just that craft.
# JSON object, slug -> sha256 hex hash.
VITE_CRAFT_PASSWORD_HASHES={"multi-payroll":"","editable-invoice":"","employee-filters":"","demo-annotations":"","schedule-report":"","split-pay":"","emma-mobile":"","tokens-billing":"","emma-intake":"","dynamic-timeline":""}
